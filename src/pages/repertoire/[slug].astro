---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const songs = await getCollection('songs');
  return songs.map((song) => ({
    params: { slug: song.id },
    props: { song },
  }));
}

const { song } = Astro.props;
const { Content } = await render(song);

// In welchen Setlisten kommt der Song vor?
const setlisten = (await getCollection('setlisten')).filter((liste) =>
  liste.data.sets.some((set) => set.songs.some((s) => s.slug === song.id))
);

const facts = [
  { label: 'Tempo', value: song.data.tempo },
  { label: 'Tonart', value: song.data.key },
  { label: 'Feel', value: song.data.feel },
  { label: 'Besetzung', value: song.data.besetzung },
].filter((f) => f.value);
---

<BaseLayout title={song.data.title} description={`Song-Infos: ${song.data.title}`} noindex>
  <section class="section">
    <div class="container song-page">
      <nav class="breadcrumb">
        <a href="/intern/">Intern</a> / <a href="/repertoire/">Repertoire</a>
      </nav>

      <h1 class="song-heading">
        {song.data.title}
        {song.data.status === 'in-arbeit' && <span class="status-badge">in Arbeit</span>}
      </h1>
      {song.data.artist && <p class="song-artist">{song.data.artist}</p>}

      {facts.length > 0 && (
        <div class="facts">
          {facts.map((f) => (
            <div class="fact card">
              <span class="fact-label">{f.label}</span>
              <span class="fact-value">{f.value}</span>
            </div>
          ))}
        </div>
      )}

      {song.data.vocals && song.data.vocals.length > 0 && (
        <div class="vocals card">
          <h2>Gesang</h2>
          <table>
            <tbody>
              {song.data.vocals.map((v) => (
                <tr>
                  <td class="vocals-who">{v.wer}</td>
                  <td>{v.part}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      {song.data.sheets && song.data.sheets.length > 0 && (
        <div class="sheets card">
          <h2>Noten</h2>
          <ul>
            {song.data.sheets.map((sheet) => (
              <li>
                <a href={sheet.src} target="_blank" rel="noopener">{sheet.label}</a>
              </li>
            ))}
          </ul>
        </div>
      )}

      {song.data.audio && song.data.audio.length > 0 && (
        <div class="recordings card">
          <h2>Aufnahmen aus der Probe</h2>
          <ul>
            {song.data.audio.map((a) => (
              <li>
                <span class="recording-label">{a.label}</span>
                <audio controls preload="none" src={a.src} />
              </li>
            ))}
          </ul>
        </div>
      )}

      {song.data.video && song.data.video.length > 0 && (
        <div class="videos card">
          <h2>Videos aus der Probe</h2>
          <div class="video-grid">
            {song.data.video.map((v) => (
              <figure>
                <video controls preload="metadata" src={v.src} />
                <figcaption>{v.label}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      )}

      <article class="song-content">
        <Content />
      </article>

      {setlisten.length > 0 && (
        <aside class="in-setlists">
          <h2>In diesen Setlisten</h2>
          <ul>
            {setlisten.map((liste) => (
              <li><a href={`/setlisten/${liste.id}/`}>{liste.data.title}</a></li>
            ))}
          </ul>
        </aside>
      )}
    </div>
  </section>
</BaseLayout>

<script>
  // Notations-Blöcke (```abc im Markdown) als Notensystem rendern.
  const blocks = document.querySelectorAll('pre[data-language="abc"]');
  if (blocks.length > 0) {
    const abcjs = await import('abcjs');
    blocks.forEach((pre) => {
      const abc = pre.textContent ?? '';
      const sheet = document.createElement('div');
      sheet.className = 'sheet';
      pre.replaceWith(sheet);

      // Überschrift direkt über dem Block gehört zu diesem Notensystem:
      // in die Karte ziehen, damit die Zuordnung eindeutig ist.
      const heading = sheet.previousElementSibling;
      if (heading && heading.tagName === 'H3') {
        heading.classList.add('sheet-label');
        sheet.appendChild(heading);
      }

      const staff = document.createElement('div');
      sheet.appendChild(staff);

      abcjs.renderAbc(staff, abc, {
        responsive: 'resize',
        staffwidth: 720,
        paddingtop: 4,
        paddingbottom: 4,
        paddingleft: 12,
        paddingright: 12,
        format: {
          stretchlast: 1,
          titlefont: 'Helvetica bold 18',
          composerfont: 'Helvetica 11',
          gchordfont: 'Helvetica bold 13',
          annotationfont: 'Helvetica bold 11',
          textfont: 'Helvetica bold 11',
          measurefont: 'Helvetica 9',
          partsfont: 'Helvetica bold 13',
        },
      });
    });
  }
</script>

<style is:global>
  .song-content .sheet {
    background: #fff;
    color: #000;
    border-radius: 10px;
    padding: 0 1.25rem 0.75rem;
    margin: 1.5rem 0;
    overflow-x: auto;
  }

  .song-content .sheet-label {
    margin: 0 -1.25rem 0.5rem;
    padding: 0.6rem 1.25rem;
    border-bottom: 1px solid #d8d8d8;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #111;
  }

  /* Überschriften ohne eigenes Notensystem bleiben im Seiten-Stil */
  .song-content h3:not(.sheet-label) {
    font-size: 1.1rem;
    margin: 1.5rem 0 0.5rem;
  }

  .song-content .sheet svg {
    max-width: 100%;
  }

  @media print {
    .song-content .sheet {
      border-radius: 0;
      padding: 0;
    }
  }
</style>

<style>
  .song-page {
    max-width: 800px;
  }

  .breadcrumb {
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .breadcrumb a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--color-primary-light);
  }

  .song-heading {
    font-size: clamp(2rem, 5vw, 3rem);
    display: flex;
    align-items: center;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  .song-artist {
    color: var(--color-text-muted);
    font-size: 1.1rem;
    margin-top: 0.25rem;
  }

  .status-badge {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #e8b23a;
    border: 1px solid #e8b23a;
    border-radius: 4px;
    padding: 0.15rem 0.5rem;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 1rem;
    margin: 2rem 0;
  }

  .fact {
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .fact-label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--color-text-muted);
  }

  .fact-value {
    font-weight: 600;
    font-size: 1.05rem;
  }

  .vocals {
    padding: 1.25rem 1.5rem;
    margin-bottom: 2rem;
  }

  .vocals h2 {
    font-size: 1.1rem;
    margin-bottom: 0.75rem;
  }

  .vocals table {
    width: 100%;
    border-collapse: collapse;
  }

  .vocals td {
    padding: 0.4rem 0;
    border-top: 1px solid var(--color-border);
    font-size: 0.95rem;
  }

  .vocals-who {
    font-weight: 600;
    width: 8rem;
    color: var(--color-primary-light);
  }

  .sheets {
    padding: 1.25rem 1.5rem;
    margin-bottom: 2rem;
  }

  .sheets h2 {
    font-size: 1.1rem;
    margin-bottom: 0.75rem;
  }

  .sheets ul {
    list-style: none;
    padding: 0;
  }

  .sheets a {
    color: var(--color-primary-light);
    text-decoration: none;
  }

  .sheets a:hover {
    text-decoration: underline;
  }

  .recordings {
    padding: 1.25rem 1.5rem;
    margin-bottom: 2rem;
  }

  .recordings h2 {
    font-size: 1.1rem;
    margin-bottom: 0.75rem;
  }

  .recordings ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .recordings li {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    border-top: 1px solid var(--color-border);
    padding-top: 0.75rem;
  }

  .recording-label {
    font-size: 0.9rem;
    font-weight: 600;
    min-width: 12rem;
    flex: 1;
  }

  .recordings audio {
    height: 2.2rem;
    max-width: 100%;
  }

  .videos {
    padding: 1.25rem 1.5rem;
    margin-bottom: 2rem;
  }

  .videos h2 {
    font-size: 1.1rem;
    margin-bottom: 0.75rem;
  }

  .video-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1rem;
  }

  .video-grid video {
    width: 100%;
    max-height: 400px;
    border-radius: 8px;
    background: #000;
  }

  .video-grid figcaption {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-top: 0.4rem;
  }

  .song-content :global(h2) {
    font-size: 1.4rem;
    margin: 2rem 0 0.75rem;
  }

  .song-content :global(ol),
  .song-content :global(ul) {
    padding-left: 1.4rem;
    line-height: 1.8;
  }

  .song-content :global(p) {
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .song-content :global(blockquote) {
    border-left: 3px solid #e8b23a;
    padding: 0.5rem 1rem;
    color: var(--color-text-muted);
    margin: 1rem 0;
  }

  .in-setlists {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .in-setlists h2 {
    font-size: 1.1rem;
    margin-bottom: 0.75rem;
  }

  .in-setlists ul {
    list-style: none;
    padding: 0;
  }

  .in-setlists a {
    color: var(--color-primary-light);
    text-decoration: none;
  }

  .in-setlists a:hover {
    text-decoration: underline;
  }
</style>
