# Automatisch generiert aus vercel.json — Redirects der alten WordPress-URLs

ErrorDocument 404 /404.html

# HTTPS + www erzwingen
RewriteEngine On
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.rotary-band.de/$1 [R=301,L]

RedirectMatch 301 ^/events/hochzeiten/?$ /die-band-fur-eure-hochzeit/
